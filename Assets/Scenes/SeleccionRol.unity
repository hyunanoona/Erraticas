  p2DescripcionTexto: {fileID: 924393554}
  ratita1Rol: Cazador
  ratita2Rol: Soporte
  ratita1TipoRol: 
  ratita2TipoRol: 
  opcionesCazador:
  - nombreTipo: Cunty
    imagenRataMenu: {fileID: -261067619, guid: d739b61910898c843b8eb664ba6aac05, type: 3}
    descripcionTipo: "Seduce al chef con su coqueta mirada y no te lanza obst\xE1culos
      por cierto rato "
  - nombreTipo: Faso
    imagenRataMenu: {fileID: -1483006566, guid: bae942b014878e4449766d8ab74e8ccb, type: 3}
    descripcionTipo: Con su poderosa habilidad de rastreo, salen a la luz quesos
      escondidos
  opcionesSoporte:
  - nombreTipo: Nico Tina
    imagenRataMenu: {fileID: -167579236, guid: 42a0fa73f7e742e45bf468a086ed41cb, type: 3}
    descripcionTipo: 'Otorga inmunidad cuando come mucho queso roquefort

      Cura
      al recoger el queso del tipo mozzarella

'
  - nombreTipo: Lava Rigota
    imagenRataMenu: {fileID: -2078986898, guid: 7d5c391835e76c54c928bfec71bca791, type: 3}
    descripcionTipo: "Aumenta la velocidad cuando se traga una buena cantidad de
      provoleta.\r\n El salto se vuelve doble si se le cruzan varios quesitos cremosos
      \r\n"
